# Google service account (Sheets and Calendar)
# Keep the \n line breaks and wrap the value in quotes
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_ID=
GOOGLE_CALENDAR_ID=
